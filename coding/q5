public class Q5_TicketPriceSlotFinder {
    static int searchInsert(int[] prices, int target) {
        int low = 0;
        int high = prices.length - 1;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (prices[mid] == target) {
                return mid;
            } else if (prices[mid] < target) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        return low;
    }

    public static void main(String[] args) {
        int[] prices = {120, 150, 200, 260};

        System.out.println(searchInsert(prices, 150));
        System.out.println(searchInsert(prices, 210));
        System.out.println(searchInsert(prices, 300));
    }
}
