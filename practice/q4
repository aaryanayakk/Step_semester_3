import java.time.LocalDate;
import java.util.*;

abstract class Room {
    String roomNumber;

    Room(String roomNumber) {
        this.roomNumber = roomNumber;
    }

    abstract double getPricePerNight();

    double calculatePrice(long nights) {
        return getPricePerNight() * nights;
    }
}

class StandardRoom extends Room {
    StandardRoom(String roomNumber) {
        super(roomNumber);
    }

    double getPricePerNight() {
        return 2000;
    }
}

class DeluxeRoom extends Room {
    DeluxeRoom(String roomNumber) {
        super(roomNumber);
    }

    double getPricePerNight() {
        return 3500;
    }
}

class Suite extends Room {
    Suite(String roomNumber) {
        super(roomNumber);
    }

    double getPricePerNight() {
        return 5000;
    }
}

class Customer {
    String name;

    Customer(String name) {
        this.name = name;
    }
}

class Reservation {
    Customer customer;
    Room room;
    LocalDate startDate;
    LocalDate endDate;
    LocalDate cancellationDeadline;
    boolean cancelled;

    Reservation(Customer customer, Room room, LocalDate startDate,
                LocalDate endDate, LocalDate cancellationDeadline) {
        this.customer = customer;
        this.room = room;
        this.startDate = startDate;
        this.endDate = endDate;
        this.cancellationDeadline = cancellationDeadline;
        this.cancelled = false;
    }

    double calculatePrice() {
        long nights = endDate.toEpochDay() - startDate.toEpochDay();
        return room.calculatePrice(nights);
    }

    boolean overlaps(LocalDate start, LocalDate end) {
        return !cancelled && startDate.isBefore(end) && start.isBefore(endDate);
    }

    void cancel(LocalDate today) {
        if (cancelled) {
            System.out.println("Reservation is already cancelled.");
        } else if (today.isAfter(cancellationDeadline)) {
            System.out.println("Cancellation deadline has passed.");
        } else {
            cancelled = true;
            System.out.println("Reservation for " + customer.name + ", "
                    + room.roomNumber + " (" + startDate + " to "
                    + endDate + ") cancelled successfully.");
        }
    }
}

class HotelBookingSystem {
    private List<Reservation> reservations = new ArrayList<>();

    boolean isAvailable(Room room, LocalDate start, LocalDate end) {
        for (Reservation reservation : reservations) {
            if (reservation.room.roomNumber.equals(room.roomNumber)
                    && reservation.overlaps(start, end)) {
                return false;
            }
        }

        return true;
    }

    Reservation bookRoom(Customer customer, Room room, LocalDate start,
                         LocalDate end, LocalDate deadline) {
        if (!start.isBefore(end)) {
            System.out.println("Invalid reservation dates.");
            return null;
        }

        if (!isAvailable(room, start, end)) {
            System.out.println(room.roomNumber + " is not available from "
                    + start + " to " + end + ".");
            return null;
        }

        Reservation reservation = new Reservation(
                customer, room, start, end, deadline);

        reservations.add(reservation);

        System.out.println("Reservation confirmed for " + customer.name + ", "
                + room.getClass().getSimpleName() + " "
                + room.roomNumber + " (" + start + " to " + end + ").");

        System.out.printf("Price: ₹%.2f%n", reservation.calculatePrice());

        return reservation;
    }
}

public class Q4_HotelBookingSystem {
    public static void main(String[] args) {
        HotelBookingSystem system = new HotelBookingSystem();

        Customer a = new Customer("Customer A");
        Customer b = new Customer("Customer B");
        Customer c = new Customer("Customer C");

        Room standard = new StandardRoom("101");
        Room deluxe = new DeluxeRoom("201");

        LocalDate start1 = LocalDate.of(2026, 1, 1);
        LocalDate end1 = LocalDate.of(2026, 1, 5);

        if (system.isAvailable(standard, start1, end1)) {
            System.out.println("Standard Room 101 is available from "
                    + start1 + " to " + end1 + ".");
        }

        Reservation r1 = system.bookRoom(
                a, standard, start1, end1,
                LocalDate.of(2025, 12, 30));

        system.bookRoom(
                b, standard,
                LocalDate.of(2026, 1, 3),
                LocalDate.of(2026, 1, 7),
                LocalDate.of(2026, 1, 1));

        if (r1 != null) {
            r1.cancel(LocalDate.of(2025, 12, 29));
        }

        system.bookRoom(
                c, deluxe,
                LocalDate.of(2026, 2, 10),
                LocalDate.of(2026, 2, 12),
                LocalDate.of(2026, 2, 5));
    }
}
